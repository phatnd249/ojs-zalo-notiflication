<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
<head>
<meta charset="utf-8">
<title>Báo cáo Chi tiết Tiến độ Phản biện</title>
<style>
@page Section1 {
    size: 841.9pt 595.3pt; /* A4 Landscape */
    margin: 2cm 1.5cm 2cm 1.5cm;
    mso-page-orientation: landscape;
}
div.Section1 { page: Section1; }
body {
    font-family: 'Times New Roman', Times, serif;
    font-size: 11pt;
    line-height: 1.3;
    color: #000;
}
table.header-table {
    width: 100%;
    margin-bottom: 20px;
    border-collapse: collapse;
}
table.header-table td {
    vertical-align: top;
}
h2 {
    text-align: center;
    font-size: 15pt;
    text-transform: uppercase;
    margin: 15px 0 5px 0;
    font-weight: bold;
}
p.subtitle {
    text-align: center;
    font-style: italic;
    margin: 0 0 20px 0;
    font-size: 11pt;
}
table.data-table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 25px;
}
table.data-table th, table.data-table td {
    border: 1px solid #333;
    padding: 6px 8px;
    font-size: 10pt;
}
table.data-table th {
    background-color: #f2f2f2;
    font-weight: bold;
    text-align: center;
}
.text-center { text-align: center; }
.badge-early { color: #007700; font-weight: bold; }
.badge-ontime { color: #0055aa; font-weight: bold; }
.badge-late { color: #cc0000; font-weight: bold; }
table.sign-table {
    width: 100%;
    margin-top: 30px;
    border-collapse: collapse;
}
table.sign-table td {
    width: 50%;
    text-align: center;
    vertical-align: top;
    font-size: 11pt;
}
</style>
</head>
<body>
<div class="Section1">

<table class="header-table">
    <tr>
        <td style="width: 55%; text-align: center;">
            <strong>CƠ QUAN CHỦ QUẢN</strong><br>
            <strong>TẠP CHÍ KHOA HỌC ....................</strong><br>
            <span style="font-size: 9pt;">Số: ..... /BC-TCKH</span>
        </td>
        <td style="width: 45%; text-align: center;">
            <strong>CỘNG HÒA XÃ HỘI CHỦ NGHĨA VIỆT NAM</strong><br>
            <strong>Độc lập – Tự do – Hạnh phúc</strong><br>
            <em>.................., ngày ..... tháng ..... năm 202...</em>
        </td>
    </tr>
</table>

<h2>BẢNG TỔNG HỢP CHI TIẾT TIẾN ĐỘ PHẢN BIỆN BÀI BÁO</h2>
<p class="subtitle">Tháng ....... Năm 202...</p>

<table class="data-table">
    <thead>
        <tr>
            <th style="width: 4%;">STT</th>
            <th style="width: 8%;">Mã bài</th>
            <th style="width: 25%;">Tên bài báo</th>
            <th style="width: 18%;">Họ và tên Phản biện viên</th>
            <th style="width: 10%;">Ngày gửi mời</th>
            <th style="width: 10%;">Hạn chót</th>
            <th style="width: 10%;">Ngày nộp</th>
            <th style="width: 10%;">Tiến độ</th>
            <th style="width: 15%;">Đề xuất của PBV</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td class="text-center">1</td>
            <td class="text-center"><strong>#1042</strong></td>
            <td>Ứng dụng AI trong giáo dục đại học</td>
            <td>PGS. TS. Nguyễn Văn A<br><small style="color:#555;">ĐH Sư phạm Hà Nội</small></td>
            <td class="text-center">05/10/2026</td>
            <td class="text-center">19/10/2026</td>
            <td class="text-center">18/10/2026</td>
            <td class="text-center badge-early">Sớm 1 ngày</td>
            <td>Chấp nhận có sửa chữa</td>
        </tr>
        <tr>
            <td class="text-center">2</td>
            <td class="text-center"><strong>#1055</strong></td>
            <td>Phân tích hồi quy đa biến tác động kinh tế</td>
            <td>TS. Trần Thị B<br><small style="color:#555;">Viện Kinh tế Việt Nam</small></td>
            <td class="text-center">02/10/2026</td>
            <td class="text-center">16/10/2026</td>
            <td class="text-center">18/10/2026</td>
            <td class="text-center badge-late">Trễ 2 ngày</td>
            <td>Chỉnh sửa lớn (Major)</td>
        </tr>
        <tr>
            <td class="text-center">3</td>
            <td class="text-center"><strong>#1060</strong></td>
            <td>Thực trạng chuyển đổi số tại các DNNVV</td>
            <td>ThS. Lê Văn C<br><small style="color:#555;">ĐH Kinh tế Quốc dân</small></td>
            <td class="text-center">12/10/2026</td>
            <td class="text-center">26/10/2026</td>
            <td class="text-center">25/10/2026</td>
            <td class="text-center badge-ontime">Đúng hạn</td>
            <td>Từ chối đăng (Decline)</td>
        </tr>
        <tr>
            <td class="text-center">4</td>
            <td class="text-center"><strong>#1068</strong></td>
            <td>Đánh giá tác động biến đổi khí hậu ĐBSCL</td>
            <td>PGS. TS. Phạm Hoàng D<br><small style="color:#555;">ĐH Cần Thơ</small></td>
            <td class="text-center">15/10/2026</td>
            <td class="text-center">29/10/2026</td>
            <td class="text-center">28/10/2026</td>
            <td class="text-center badge-ontime">Đúng hạn</td>
            <td>Chấp nhận đăng (Accept)</td>
        </tr>
        <tr>
            <td class="text-center">5</td>
            <td class="text-center"><strong>#1075</strong></td>
            <td>Phát triển du lịch bền vững tại miền Trung</td>
            <td>TS. Vũ Minh E<br><small style="color:#555;">ĐH Huế</small></td>
            <td class="text-center">18/10/2026</td>
            <td class="text-center">01/11/2026</td>
            <td class="text-center">30/10/2026</td>
            <td class="text-center badge-early">Sớm 2 ngày</td>
            <td>Chấp nhận có sửa chữa</td>
        </tr>
    </tbody>
</table>

<table class="sign-table">
    <tr>
        <td>
            <strong>NGƯỜI LẬP BIỂU</strong><br>
            <em>(Ký, ghi rõ họ tên)</em><br><br><br><br><br>
            <strong>Thư ký tòa soạn</strong>
        </td>
        <td>
            <strong>TỔNG BIÊN TẬP PHÊ DUYỆT</strong><br>
            <em>(Ký, đóng dấu, ghi rõ họ tên)</em><br><br><br><br><br>
            <strong>....................................................</strong>
        </td>
    </tr>
</table>

</div>
</body>
</html>